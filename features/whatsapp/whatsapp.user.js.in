// ==UserScript==
// @name         Steel — WhatsApp layout
// @namespace    steel.local
// @version      1.0.6
// @description  Full, avatar-only and hidden chat list, with a draggable width.
// @match        https://web.whatsapp.com/*
// @run-at       document-start
// @grant        none
// ==/UserScript==

(() => {
  'use strict';
  // Install before WhatsApp paints its startup animation; layout waits for the DOM.
  document.getElementById('steel-whatsapp-startup-style')?.remove();
  const splashStyle = document.createElement('style');
  splashStyle.id = 'steel-whatsapp-startup-style'; splashStyle.className = 'darkreader';
  splashStyle.textContent = `
    ._apdl ._apdm::before, ._apdl ._apdm::after {
      content: none !important; display: none !important; width: 0 !important;
      background: none !important; animation: none !important;
    }
    ._apdl ._aw0k { animation: none !important; will-change: auto !important; }
    #app [data-asset-chat-background] { display: none !important; }
    ._apdl ._apdm { visibility: hidden !important; }
    #app :is([data-testid="drawer-left"], [data-testid="drawer-middle"]) {
      border-inline: 0 !important; box-shadow: none !important;
    }
  `;
  (document.head || document.documentElement).append(splashStyle);
  function initializeLayout() {
  window.__steelWhatsAppLayout?.destroy();
  const defaults = {{layout.whatsapp_json}};
  const key = 'steel.whatsapp.layout.v1';
  let saved = {};
  try { saved = JSON.parse(localStorage.getItem(key) || '{}'); } catch {}
  const state = {
    width: Number.isFinite(saved.width) ? saved.width : defaults.width,
    mode: ['full', 'compact', 'hidden'].includes(saved.mode) ? saved.mode : 'full',
    previous: saved.previous === 'compact' ? 'compact' : 'full'
  };
  let panel, content, layout, effectiveMode, frame = 0, drag, manualFull = false;
  const styles = document.createElement('style');
  styles.id = 'steel-whatsapp-layout-style';
  styles.className = 'darkreader';
  styles.textContent = `
    body, #app, .app-wrapper-web { min-width: 0 !important; }
    [data-steel-chat-list], [data-steel-chat-content] {
      min-width: 0 !important; max-width: none !important;
      background: transparent !important; box-shadow: none !important;
      border-left: 0 !important; border-right: 0 !important;
    }
    [data-steel-chat-list]::before, [data-steel-chat-list]::after {
      background: none !important; box-shadow: none !important;
    }
    [data-steel-chat-content] {
      flex: 1 1 0% !important; width: 0 !important;
      position: relative !important; inset: auto !important; transform: none !important;
    }
    [data-steel-chat-list] #side, [data-steel-chat-list] #pane-side { min-width: 0 !important; width: 100% !important; }
    [data-steel-chat-list][data-steel-mode="compact"] > header,
    [data-steel-chat-list][data-steel-mode="compact"] #side > :not(#pane-side),
    [data-steel-chat-list][data-steel-mode="compact"] [data-steel-preview] { display: none !important; }
    [data-steel-chat-list][data-steel-mode="compact"] #pane-side { scrollbar-width: none; }
    [data-steel-chat-list][data-steel-mode="compact"] #pane-side [role="row"] :not([data-steel-avatar], [data-steel-avatar] *) { visibility: hidden !important; }
    [data-steel-chat-list][data-steel-mode="compact"] [data-steel-avatar-host] { position: static !important; }
    [data-steel-chat-list][data-steel-mode="compact"] [data-steel-avatar] {
      position: absolute !important; left: 50% !important; top: var(--steel-avatar-center-y, 50%) !important;
      transform: translate(-50%, -50%) !important; width: 48px !important; height: 48px !important;
      margin: 0 !important; padding: 0 !important; visibility: visible !important;
    }
    [data-steel-chat-list][data-steel-mode="compact"] [data-steel-avatar] * { visibility: visible !important; }
    /* Clip the photograph itself, leaving sibling status badges outside it. */
    [data-steel-chat-list][data-steel-mode="compact"] [data-steel-avatar] img {
      border-radius: 50% !important; clip-path: circle(50%) !important;
    }
    [data-steel-chat-list][data-steel-mode="compact"] [data-steel-avatar] image {
      clip-path: circle(50%) fill-box !important;
    }
    [data-steel-chat-list][data-steel-mode="compact"] #pane-side [role="row"] [data-steel-unread-host] { position: static !important; transform: none !important; will-change: auto !important; overflow: visible !important; }
    [data-steel-chat-list][data-steel-mode="compact"] #pane-side [role="row"] [data-steel-unread],
    [data-steel-chat-list][data-steel-mode="compact"] #pane-side [role="row"] [data-steel-unread] * { visibility: visible !important; }
    [data-steel-chat-list][data-steel-mode="compact"] #pane-side [role="row"] [data-steel-unread] {
      position: absolute !important; z-index: 3 !important;
      left: auto !important; right: calc(50% - 26px) !important;
      top: calc(var(--steel-avatar-center-y, 50%) - 24px) !important; bottom: auto !important;
      transform: translateY(-40%) !important;
      display: inline-flex !important; align-items: center !important; justify-content: center !important;
      min-width: 16px !important; width: auto !important; height: 16px !important;
      padding: 0 3px !important; margin: 0 !important; box-sizing: border-box !important;
      border-radius: 999px !important; border: 1px solid var(--steel-background, #161a1f) !important;
      pointer-events: none !important;
    }
    [data-steel-chat-list][data-steel-mode="compact"] #pane-side [role="row"] [data-steel-unread] * {
      font-size: 10px !important; line-height: 1 !important;
    }
    .steel-wa-button {
      position: fixed; z-index: 1000; left: 16px; width: 32px; height: 32px;
      padding: 6px; border: 0; border-radius: 8px; cursor: pointer;
      color: var(--steel-text, CanvasText); background: transparent;
      display: grid; place-items: center; box-sizing: border-box;
    }
    .steel-wa-button:hover, .steel-wa-button:focus-visible { background: var(--steel-selection, ButtonFace); outline: none; }
    .steel-wa-button[aria-pressed="true"] { color: var(--steel-accent, Highlight); }
    .steel-wa-button[hidden], #steel-wa-resize[hidden] { display: none !important; }
    .steel-wa-button svg { width: 20px; height: 20px; background: transparent !important; }
    #steel-wa-hide { bottom: 130px; }
    #steel-wa-compact { bottom: 172px; }
    #steel-wa-resize {
      position: fixed; top: 0; bottom: 0; z-index: 900; width: 8px;
      cursor: col-resize; touch-action: none; background: transparent !important;
    }
    #steel-wa-resize::after { content: ''; position: absolute; left: 3px; top: 0; bottom: 0; width: 2px; background: transparent; }
    #steel-wa-resize:hover::after, #steel-wa-resize:focus-visible::after { background: var(--steel-accent, Highlight); }
  `;
  document.head.append(styles);
  const icon = paths => `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">${paths}</svg>`;
  const makeButton = (id, drawing, callback) => {
    const button = document.createElement('button');
    button.id = id; button.className = 'steel-wa-button'; button.type = 'button';
    button.innerHTML = icon(drawing);
    button.addEventListener('click', callback);
    document.body.append(button);
    return button;
  };
  const save = () => { try { localStorage.setItem(key, JSON.stringify(state)); } catch {} };
  const hide = makeButton('steel-wa-hide', '<rect x="3" y="4" width="18" height="16" rx="2"/><path d="M9 4v16M5.5 8h1M5.5 12h1M5.5 16h1"/>', () => {
    if (state.mode === 'hidden') state.mode = state.previous;
    else { state.previous = state.mode; state.mode = 'hidden'; }
    save(); schedule();
  });
  const compact = makeButton('steel-wa-compact', '<circle cx="12" cy="8" r="3"/><path d="M6 20v-2a6 6 0 0 1 12 0v2M4 4v16M20 4v16"/>', () => {
    state.mode = state.mode === 'compact' ? 'full' : 'compact';
    state.previous = state.mode; manualFull = state.mode === 'full'; save(); schedule();
  });
  const handle = document.createElement('div');
  handle.id = 'steel-wa-resize'; handle.role = 'separator'; handle.tabIndex = 0;
  handle.setAttribute('aria-orientation', 'vertical');
  handle.setAttribute('aria-label', 'Ancho de la lista de chats');
  handle.title = 'Arrastra para ajustar el ancho. Doble clic para restaurar.';
  document.body.append(handle);
  const zoom = () => Number.parseFloat(getComputedStyle(document.documentElement).zoom) || 1;
  const clamp = width => Math.max(defaults.minWidth, Math.min(width, defaults.maxWidth, (innerWidth - 64) / zoom() - defaults.chatMinWidth));
  const setWidth = width => { state.width = clamp(width); state.mode = 'full'; schedule(); };
  handle.addEventListener('pointerdown', event => {
    if (event.button !== 0) return;
    event.preventDefault(); handle.setPointerCapture(event.pointerId);
    drag = {x: event.clientX, width: panel.getBoundingClientRect().width / zoom(), initial: state.width};
  });
  handle.addEventListener('pointermove', event => { if (drag) setWidth(drag.width + (event.clientX - drag.x) / zoom()); });
  const finish = () => { if (drag) { drag = null; save(); } };
  handle.addEventListener('pointerup', finish);
  handle.addEventListener('pointercancel', () => { if (drag) state.width = drag.initial; finish(); schedule(); });
  handle.addEventListener('dblclick', () => { setWidth(defaults.width); save(); });
  handle.addEventListener('keydown', event => {
    if (event.key === 'ArrowLeft' || event.key === 'ArrowRight') { event.preventDefault(); setWidth(state.width + (event.key === 'ArrowRight' ? 16 : -16)); save(); }
    else if (event.key === 'Home') { setWidth(defaults.width); save(); }
  });

  function markUnread(row, centerY) {
    // Reposition the live native counter so React owns its count and lifecycle.
    // Disappearing-message badges inside the avatar are left in place.
    const badge = row.querySelector('[data-testid="icon-unread-count"]');
    if (!badge) return;
    if (!badge.hasAttribute('data-steel-unread')) badge.dataset.steelUnread = '';
    if (badge.style.getPropertyValue('--steel-avatar-center-y') !== centerY)
      badge.style.setProperty('--steel-avatar-center-y', centerY);
    for (let host = badge.parentElement; host && host !== row; host = host.parentElement)
      if (!host.hasAttribute('data-steel-unread-host')) host.dataset.steelUnreadHost = '';
  }
  function markAvatars() {
    for (const row of document.querySelectorAll('#pane-side [role="row"]')) {
      // Keep the live native avatar: SVG masks, photos and disappearing-message
      // badges must retain their identity and continue receiving React updates.
      let avatar = row.querySelector('[data-steel-avatar]');
      if (!avatar) {
        avatar = [...row.querySelectorAll('div')].find(element => {
          const style = getComputedStyle(element);
          return style.getPropertyValue('--x-width').trim() === '48px'
            && style.getPropertyValue('--x-height').trim() === '48px';
        });
        if (!avatar) {
          const image = row.querySelector('img');
          if (image) {
            avatar = image;
            while (avatar.parentElement && avatar.parentElement !== row) {
              const r = avatar.parentElement.getBoundingClientRect();
              if (r.width < 46 * zoom() || r.width > 52 * zoom() || r.height < 46 * zoom() || r.height > 52 * zoom()) break;
              avatar = avatar.parentElement;
            }
          }
        }
        if (avatar) avatar.dataset.steelAvatar = '';
      }
      if (!avatar) continue;
      const centerY = `${row.getBoundingClientRect().height / (2 * zoom())}px`;
      avatar.style.setProperty('--steel-avatar-center-y', centerY);
      markUnread(row, centerY);
      for (let host = avatar.parentElement; host && host !== row; host = host.parentElement)
        host.dataset.steelAvatarHost = '';
    }
  }
  function update() {
    frame = 0;
    const side = document.querySelector('#side');
    if (!side) { hide.hidden = compact.hidden = handle.hidden = true; return; }
    panel = side.parentElement; layout = panel.parentElement;
    content = panel.nextElementSibling;
    panel.dataset.steelChatList = '';
    if (content) content.dataset.steelChatContent = '';
    const chatOpen = !!document.querySelector('#main');
    const narrow = innerWidth / zoom() < defaults.autoCompactAt;
    effectiveMode = state.mode === 'full' && narrow && chatOpen && !manualFull ? 'compact' : state.mode;
    panel.dataset.steelMode = effectiveMode;
    const width = effectiveMode === 'compact' ? defaults.compactWidth : clamp(state.width);
    panel.style.setProperty('flex', `0 0 ${width}px`, 'important');
    panel.style.setProperty('width', `${width}px`, 'important');
    panel.style.setProperty('display', effectiveMode === 'hidden' ? 'none' : 'flex', 'important');
    hide.hidden = compact.hidden = false;
    hide.title = effectiveMode === 'hidden' ? 'Mostrar lista de chats' : 'Ocultar lista de chats';
    hide.setAttribute('aria-label', hide.title); hide.setAttribute('aria-pressed', String(effectiveMode === 'hidden'));
    compact.title = effectiveMode === 'compact' ? 'Mostrar nombres y previews' : 'Mostrar solo avatares';
    compact.setAttribute('aria-label', compact.title); compact.setAttribute('aria-pressed', String(effectiveMode === 'compact'));
    handle.hidden = effectiveMode !== 'full';
    handle.style.left = `${panel.getBoundingClientRect().right / zoom() - 4}px`;
    handle.setAttribute('aria-valuenow', String(Math.round(width)));
    handle.setAttribute('aria-valuemin', String(defaults.minWidth));
    handle.setAttribute('aria-valuemax', String(defaults.maxWidth));
    markAvatars();
  }
  function schedule() { if (!frame) frame = requestAnimationFrame(update); }
  const observer = new MutationObserver(schedule);
  observer.observe(document.body, {childList: true, subtree: true, attributes: true, attributeFilter: ['src']});
  const resize = new ResizeObserver(schedule); resize.observe(document.documentElement);
  const onResize = () => { manualFull = false; schedule(); };
  window.addEventListener('resize', onResize);
  schedule();
  window.__steelWhatsAppLayout = {
    state,
    destroy() {
      observer.disconnect(); resize.disconnect(); cancelAnimationFrame(frame);
      window.removeEventListener('resize', onResize);
      for (const element of [styles, hide, compact, handle, ...document.querySelectorAll('.steel-wa-profile')]) element.remove();
      if (panel) { for (const property of ['display', 'width', 'flex']) panel.style.removeProperty(property); delete panel.dataset.steelChatList; delete panel.dataset.steelMode; }
      if (content) delete content.dataset.steelChatContent;
      for (const element of document.querySelectorAll('[data-steel-avatar], [data-steel-avatar-host], [data-steel-preview], [data-steel-unread], [data-steel-unread-host]')) { element.style.removeProperty('--steel-avatar-center-y'); delete element.dataset.steelAvatar; delete element.dataset.steelAvatarHost; delete element.dataset.steelPreview; delete element.dataset.steelUnread; delete element.dataset.steelUnreadHost; }
    }
  };
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', initializeLayout, {once: true});
  else initializeLayout();
})();
