#!/usr/bin/env python3
"""Configure the Intelligence sites of this Steel installation."""
import argparse
import json
import os
from pathlib import Path
import re
import tempfile
import subprocess
import sys
from urllib.parse import urlsplit

ROOT = Path(__file__).resolve().parent
CONFIG = ROOT / 'ui/settings/config.json'


def save(config, path=CONFIG):
    payload = json.dumps(config, ensure_ascii=False, indent=4) + '\n'
    fd, name = tempfile.mkstemp(prefix='.intelligence-', dir=path.parent)
    try:
        with os.fdopen(fd, 'w') as stream:
            stream.write(payload)
            stream.flush()
            os.fsync(stream.fileno())
        os.chmod(name, path.stat().st_mode & 0o777 if path.exists() else 0o600)
        os.replace(name, path)
    finally:
        Path(name).unlink(missing_ok=True)


def theme_command(arguments):
    import theme
    parser = argparse.ArgumentParser(description='Paleta central de Steel (Hyprland).')
    parser.add_argument('operation', choices=['show', 'set', 'render', 'apply'])
    parser.add_argument('assignments', nargs='*', metavar='TOKEN=#RRGGBB')
    parser.add_argument('--apply', action='store_true', help='Aplicar también a la instalación activa')
    args = parser.parse_args(arguments)
    if args.assignments and args.operation != 'set':
        parser.error('Los colores solo se usan con set.')
    if args.operation == 'show':
        print(json.dumps(theme.palette(ROOT), indent=2))
        return
    apply = args.operation == 'apply' or args.apply
    if apply and not (ROOT / 'INSTALLATION.json').is_file():
        parser.error('Aplica desde steel-ctl de la instalación; esta copia solo genera archivos.')
    if args.operation == 'set':
        if not args.assignments:
            parser.error('Indica al menos TOKEN=#RRGGBB, por ejemplo background=#202830.')
        colors = theme.palette(ROOT)
        patch = {}
        for assignment in args.assignments:
            key, separator, value = assignment.partition('=')
            if not separator or key not in colors or not theme.HEX.fullmatch(value):
                parser.error('Token desconocido o color inválido: ' + assignment)
            patch[key] = value.lower()
        local = ROOT / 'local-theme.json'
        data = json.loads(local.read_text()) if local.exists() else {}
        updated = theme.merge(data, {'palette': {'colors': patch}})
        candidate = theme.merge(theme.load(ROOT), updated)
        theme.resolve_colors(candidate['palette']['colors'])
        save(updated, local)
    subprocess.run([sys.executable, str(ROOT / 'theme.py'), 'apply' if apply else 'render'], check=True)


def main():
    if len(sys.argv) > 1 and sys.argv[1] == 'theme':
        theme_command(sys.argv[2:])
        return
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('action', choices=['intelligence'])
    parser.add_argument('operation', nargs='?', choices=['list', 'add', 'remove'])
    parser.add_argument('--name')
    parser.add_argument('--url')
    parser.add_argument('--id')
    args = parser.parse_args()
    config = json.loads(CONFIG.read_text())
    sites = config['sidebar']['web']['sites']
    operation = args.operation
    if operation is None:
        print('Intelligence: 1) Listar  2) Agregar  3) Quitar')
        operation = {'1': 'list', '2': 'add', '3': 'remove'}.get(input('Opción: ').strip())
        if operation is None:
            parser.error('Opción inválida; no se guardaron cambios.')
    if operation == 'list':
        for site in sites:
            print(f"{site['id']}: {site['name']} — {site['url']}")
        return
    if operation == 'add':
        if len(sites) >= 6:
            parser.error('Intelligence admite hasta seis fuentes; quita una primero.')
        name = (args.name if args.name is not None else input('Nombre: ')).strip()
        url = (args.url if args.url is not None else input('URL https://: ')).strip()
        try:
            parsed = urlsplit(url)
            valid = parsed.scheme in ('http', 'https') and parsed.hostname and not parsed.username and not parsed.password
        except ValueError:
            valid = False
        if not name or not valid or any(ord(c) < 32 for c in url):
            parser.error('Nombre o URL inválidos; no se guardaron cambios.')
        identifier = args.id or re.sub(r'[^a-z0-9]+', '-', name.lower()).strip('-')
        if not identifier or not re.fullmatch(r'[a-z0-9-]+', identifier) or any(s['id'] == identifier for s in sites):
            parser.error('ID inválido o duplicado; usa --id con letras minúsculas, números y guiones.')
        sites.append(dict(id=identifier, name=name, url=url, navigation=True, discardWhenHidden=True, lookAhead=False))
    else:
        identifier = args.id if args.id is not None else input('ID a quitar (usa list para consultarlo): ').strip()
        remaining = [site for site in sites if site['id'] != identifier]
        if len(remaining) == len(sites):
            parser.error('ID inexistente; no se guardaron cambios.')
        if not remaining:
            parser.error('Conserva al menos una fuente.')
        config['sidebar']['web']['sites'] = remaining
    save(config)
    print('Guardado. Vuelve a abrir Intelligence; si no se actualiza, reinicia su panel Quickshell.')


if __name__ == '__main__':
    try:
        main()
    except (OSError, ValueError, KeyError, EOFError, KeyboardInterrupt) as error:
        raise SystemExit(f'No se pudo completar: {error}')
